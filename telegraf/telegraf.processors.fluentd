# Starlark processor — maps Telegraf measurements to Java InsightLogger metric
# names (system.*) with semantics matching Java's pushInsightMetric.
# Attaches rich data.* breakdown fields alongside _value (Telegraf-native names).
#
# Note: round() triggers a Telegraf 1.40.2 starlark resolver bug ("undefined:
# state"). We emit numeric values via plain str() instead.
#
# ${DELPHIX_SYSTEM_UUID} / ${DELPHIX_SYSTEM_VERSION} are substituted at TOML
# parse time from env vars exported by delphix-telegraf-service.
#
# Included by delphix-telegraf-service when FLUENTD_ENABLED flag exists.
[[processors.starlark]]
  namepass = ["cpu", "estat_backend-io", "hist_estat_backend-io", "net", "estat_nfs", "hist_estat_nfs", "estat_iscsi", "hist_estat_iscsi", "tcp_stats"]
  # Run after the base-config storage_io processors (order 1-3): the name=total
  # row filter must execute first, otherwise read + write + total rows all land
  # in our accumulators and NFS/iSCSI ops counts come out doubled.
  order = 4
  source = '''
UUID            = "${DELPHIX_SYSTEM_UUID}"
VERSION         = "${DELPHIX_SYSTEM_VERSION}"
NCPU            = int("${DELPHIX_NCPU}")
# cpu input samples at telegraf.base's 10s interval. CPU_SAMPLE_MS × NCPU / 100
# converts a usage_X percentage (0-100) into whole-system CPU milliseconds
# consumed in state X over that 10s sample (Java LocalCpuCollector's unit).
CPU_SAMPLE_MS   = 10000
CPU_MS_PER_PCT  = CPU_SAMPLE_MS * NCPU / 100.0
BUCKET_NS       = 60 * 1000 * 1000 * 1000
# estat reports "avg latency(us)" in microseconds (cmd/estat.py:282,294
# accumulate (delta + 500) / 1000) and "throughput(k/s)" in kilobytes
# (cmd/estat.py:297 accumulates size / 1024). delphix.json's IoOpsDatapoint
# documents avgLatency as nanoseconds and throughput as bytes, so the Java
# fold-met events these replace carry the unscaled values.
US_TO_NS        = 1000
KB_TO_B         = 1024
# A key nothing has reported for in this many buckets is flushed by the sweep
# even though no new sample arrived for it — a network interface that goes
# away, a TCP endpoint that closes, a disk direction that goes idle. Two
# buckets leaves a full bucket of grace for the timestamp skew between inputs
# around a boundary, so a sweep never flushes a bucket still being filled.
STALE_BUCKETS   = 2
# connstat runs with -i 10 (connstat-stats.sh), so each tcp_stats sample
# describes a 10-second window.
TCP_SAMPLE_S    = 10
# A sweep advances its clock by at most this many buckets per metric. One
# out-of-range timestamp would otherwise park it somewhere real time will not
# reach for hours, silencing the sweep until it did. One bucket is what time
# passing looks like, so the clamp never retires a key still filling the
# current bucket, and a real forward step catches up within a few samples.
MAX_SWEEP_JUMP  = 1

def hist_json(hist):
    # Encode a {bucket: count} dict as a JSON object string. Both estat's "le"
    # tags and Java's latency histogram keys come from log_lin_hist_slot() on a
    # raw nanosecond delta — BCCHelper's ANALYTICS mode prints the slot value
    # unscaled (lib/bcchelper.py:312-318, unlike the human-readable mode just
    # below it), and delphix.json documents IoOpsDatapoint.latency as
    # nanoseconds — so the keys pass through as they arrive. Sorted by numeric
    # bucket value for deterministic output.
    if not hist:
        return ""
    items = []
    for bkt in sorted(hist.keys(), key=lambda x: int(x)):
        items.append('"' + bkt + '":' + str(hist[bkt]))
    return "{" + ",".join(items) + "}"

def tag_identity(m):
    m.tags["systemUniqueId"] = UUID
    m.tags["systemVersion"]  = VERSION
    return m

def cumulative_delta(key, current):
    # Delta since the previous call for this key, or 0 on the first call
    # (no previous baseline). Guards against counter wrap / device reset.
    prev = state.get(key, None)
    state[key] = current
    if prev == None:
        return 0
    d = current - prev
    if d < 0:
        return 0
    return d

def bkey(prefix, key, bkt):
    # Every per-bucket accumulator is keyed by the bucket it belongs to, so a
    # row's arrival order never matters. The storage_io processors.clone emits
    # the hist_estat_* clone ahead of its estat_* original, so an accumulator
    # shared across buckets hands bucket B's flush the first histogram rows of
    # bucket B+1.
    return prefix + key + "_" + str(bkt)

def acc(prefix, key, bkt, value):
    k = bkey(prefix, key, bkt)
    state[k] = state.get(k, 0.0) + value
    return None

def mean(total, n):
    return int(total / n) if n > 0 else 0

def gauge_sum(total):
    # Java's minute value for one of TCP_STATS' instantaneous gauges. Its
    # one-second datapoint holds the mean across the connections sampled in
    # that second (TCPStatsPair.delta():38-43 divides the combined value by the
    # combined datapoint count, which TCPStats.combine() raises once per
    # connection), and the minute datapoint the fluentd output carries sums 60
    # of those, because AnalyticsDatapointDO.combineWith() adds INTEGER axes and
    # StatisticType declares all six gauges INTEGER.
    #
    # So the minute is a sum of per-sample means, not one mean over the whole
    # bucket; the two differ as soon as a key's connection count moves with the
    # gauge. <total> is the sum of each sample's own per-connection mean,
    # floored per sample as Java's long division floors each second, leaving
    # only the seconds each sample stands for.
    return str(int(total * TCP_SAMPLE_S))

def ops_event(measurement, op, bkt, cnt, tput, lat_sum, lat_w, hist):
    # One system.*.ops event for a single op direction's 60s bucket, shaped like
    # Java LocalIoCollector's per-op datapoints.
    hist_cnt = 0
    for bv in hist.values():
        hist_cnt = hist_cnt + bv
    # Prefer the histogram sum as the authoritative count — matches Java, which
    # always used raw per-op counts so count == sum(latency buckets) exactly.
    # Falls back to the iops-derived (bcchelper-floored) count when the
    # histogram is empty.
    emit_cnt = hist_cnt if hist_cnt > 0 else int(cnt)
    if emit_cnt <= 0:
        return []
    m = Metric(measurement)
    m.time = bkt * BUCKET_NS
    m.fields["count"] = emit_cnt
    tag_identity(m)
    m.tags["data.op"]         = op
    m.tags["data.count"]      = str(emit_cnt)
    m.tags["data.avgLatency"] = str(int(mean(lat_sum, lat_w) * US_TO_NS))
    m.tags["data.throughput"] = str(int(tput * KB_TO_B))
    lt_json = hist_json(hist)
    if lt_json:
        m.tags["data.latency"] = lt_json
    return [m]

def emit_ops(prefix, measurement, op, bkt):
    return ops_event(
        measurement, op, bkt,
        state.pop(bkey(prefix + "_cnt_",  op, bkt), 0.0),
        state.pop(bkey(prefix + "_tp_",   op, bkt), 0.0),
        state.pop(bkey(prefix + "_lsum_", op, bkt), 0.0),
        state.pop(bkey(prefix + "_lw_",   op, bkt), 0.0),
        state.pop(bkey(prefix + "_hist_", op, bkt), {}))

def emit_disk(op, bkt):
    return emit_ops("dsk", "system.disk.ops", op, bkt)

def emit_nfs(op, bkt):
    return emit_ops("nfs", "system.nfs.ops", op, bkt)

def emit_iscsi(op, bkt):
    return emit_ops("isc", "system.iscsi.ops", op, bkt)

def emit_net(iface, bkt):
    # system.net.total.bytes — one event per network interface, matching
    # LocalNetworkInterfaceCollector.java which reads /proc/net/dev and emits
    # one datapoint per interface (line 191: "networkInterface is always
    # included, as the data is useless without that context").
    # _value = inBytes + outBytes, type = SUMMARY.
    in_b  = state.pop(bkey("net_in_", iface, bkt), 0.0)
    out_b = state.pop(bkey("net_out_", iface, bkt), 0.0)
    in_p  = state.pop(bkey("net_ip_", iface, bkt), 0.0)
    out_p = state.pop(bkey("net_op_", iface, bkt), 0.0)
    m = Metric("system.net.total")
    m.time = bkt * BUCKET_NS
    m.fields["bytes"] = int(in_b + out_b)
    tag_identity(m)
    m.tags["data.networkInterface"] = iface
    m.tags["data.inBytes"]          = str(int(in_b))
    m.tags["data.outBytes"]         = str(int(out_b))
    m.tags["data.inPackets"]        = str(int(in_p))
    m.tags["data.outPackets"]       = str(int(out_p))
    return [m]

def emit_tcp(key, bkt):
    # system.tcp.total.bytes — one event per (laddr, raddr, service) per bucket,
    # matching LocalTCPStatsCollector's BY_SERVICE grouping.
    #
    # TCPStatsPair.delta() splits the fields two ways. inBytes, outBytes and
    # retransmittedSegs are cumulative counters, reported as deltas, and a
    # minute's worth of them sums to the minute's total either way. The
    # unacknowledged/unsent queues and the window and RTT fields are
    # instantaneous gauges: connstat's suna and unsent are queue depths, not
    # counters (connstat.c:112-113, snd_nxt - snd_una and write_seq - snd_nxt).
    # Those six go through gauge_sum, which puts them on the minute scale
    # Java's events carry.
    #
    # connstat-stats.sh sums suna and unsent across a key's connections and
    # averages swnd/cwnd/rwnd/rtt, reporting the count as "connections", so
    # apply() divides the first two by it and takes the last four as they come.
    # Either way what accumulates here is a sum of per-sample means.
    in_b  = state.pop(bkey("tcp_in_",  key, bkt), 0.0)
    out_b = state.pop(bkey("tcp_out_", key, bkt), 0.0)
    rseg  = state.pop(bkey("tcp_rs_",  key, bkt), 0.0)
    suna  = state.pop(bkey("tcp_su_",  key, bkt), 0.0)
    unst  = state.pop(bkey("tcp_un_",  key, bkt), 0.0)
    swnd  = state.pop(bkey("tcp_sw_",  key, bkt), 0.0)
    cwnd  = state.pop(bkey("tcp_cw_",  key, bkt), 0.0)
    rwnd  = state.pop(bkey("tcp_rw_",  key, bkt), 0.0)
    rtt   = state.pop(bkey("tcp_rt_",  key, bkt), 0.0)
    parts = key.split("|")
    m = Metric("system.tcp.total")
    m.time = bkt * BUCKET_NS
    m.fields["bytes"] = int(in_b + out_b)
    tag_identity(m)
    m.tags["data.localAddress"]        = parts[0]
    m.tags["data.remoteAddress"]       = parts[1]
    m.tags["data.service"]             = parts[2]
    m.tags["data.inBytes"]             = str(int(in_b))
    m.tags["data.outBytes"]            = str(int(out_b))
    m.tags["data.retransmittedSegs"]   = str(int(rseg))
    m.tags["data.unacknowledgedBytes"] = gauge_sum(suna)
    m.tags["data.unsentBytes"]         = gauge_sum(unst)
    m.tags["data.sendWindowSize"]      = gauge_sum(swnd)
    m.tags["data.congestionWindowSize"]= gauge_sum(cwnd)
    m.tags["data.receiveWindowSize"]   = gauge_sum(rwnd)
    m.tags["data.roundTripTime"]       = gauge_sum(rtt)
    return [m]

# Per-family flush function, and the cumulative-counter baselines to drop when
# a key is retired, so state does not grow without bound with remote-address
# or interface cardinality.
FAMS = {
    "dsk": emit_disk,
    "nfs": emit_nfs,
    "isc": emit_iscsi,
    "net": emit_net,
    "tcp": emit_tcp,
}
BASELINES = {
    "dsk": [],
    "nfs": [],
    "isc": [],
    "net": ["netb_r_", "netb_s_", "netb_rp_", "netb_sp_"],
    "tcp": ["tcpb_in_", "tcpb_out_", "tcpb_rs_"],
}

def track(fam, key, bucket):
    # Record that <key> is accumulating into <bucket>, flushing the bucket it
    # was accumulating into before. Returns the metrics to emit.
    #
    # Any change of bucket flushes, backwards as well as forwards. Only the
    # bucket in keys[key] is ever popped, so a clock that steps back would
    # otherwise leave the older bucket's accumulators under a key nothing
    # flushes and nothing frees.
    keys = state.get(fam + "_keys", {})
    prev = keys.get(key, None)
    if prev == bucket:
        return []
    keys[key] = bucket
    state[fam + "_keys"] = keys
    if prev == None:
        return []
    return FAMS[fam](key, prev)

def sweep(bucket):
    # Flush every key that has gone quiet. Without this a bucket is only ever
    # flushed by the next sample carrying the same key, so a TCP endpoint that
    # closes, an interface that is removed or a disk direction that goes idle
    # would never report its last bucket. Any metric reaching this processor
    # advances time — the cpu input samples every 10s regardless of I/O — so
    # the trigger is shared across every key rather than per-key.
    last = state.get("sweep_bk", -1)
    if bucket <= last:
        return []
    if last >= 0 and bucket - last > MAX_SWEEP_JUMP:
        bucket = last + MAX_SWEEP_JUMP
    state["sweep_bk"] = bucket
    out = []
    for fam in sorted(FAMS.keys()):
        keys = state.get(fam + "_keys", {})
        stale = []
        for k in keys:
            if keys[k] + STALE_BUCKETS <= bucket:
                stale.append(k)
        if not stale:
            continue
        for k in stale:
            out.extend(FAMS[fam](k, keys[k]))
            keys.pop(k, None)
            for prefix in BASELINES[fam]:
                state.pop(prefix + k, None)
        state[fam + "_keys"] = keys
    return out

def apply(metric):
    name   = metric.name
    ts     = metric.time
    bucket = ts // BUCKET_NS
    out    = [metric]
    out.extend(sweep(bucket))

    # system.cpu.util.pct — matches Java LocalCpuCollector semantics:
    #   user   = (usage_user + usage_nice)   * CPU_MS_PER_PCT per 10s sample
    #   kernel = (usage_system + usage_irq + usage_softirq) * CPU_MS_PER_PCT
    #   idle   = (usage_idle + usage_iowait) * CPU_MS_PER_PCT  (iowait as idle)
    # Each sample's ms contributions accumulate across the 60s bucket; at flush
    # we derive pct from the minute-wide totals — Java accumulated jiffies for
    # the full minute, so sampling the last 10s misrepresents bursty workloads.
    # data.user/kernel/idle emit Java's three-bucket grouping in ms (matching
    # LocalCpuCollector's units: pct/100 × interval_ms × ncpu).
    # steal/guest excluded from numerator and denominator (Java behavior).
    # data.nice/system/iowait/irq/softirq/steal are raw-state extras in ms.
    if name == "cpu":
        if metric.tags.get("cpu") != "cpu-total":
            return out
        if "usage_idle" not in metric.fields:
            return out
        u_usr = float(metric.fields.get("usage_user",    0))
        u_nic = float(metric.fields.get("usage_nice",    0))
        u_sys = float(metric.fields.get("usage_system",  0))
        u_irq = float(metric.fields.get("usage_irq",     0))
        u_sir = float(metric.fields.get("usage_softirq", 0))
        u_idl = float(metric.fields.get("usage_idle",    0))
        u_iow = float(metric.fields.get("usage_iowait",  0))
        u_stl = float(metric.fields.get("usage_steal",   0))
        prev_bucket = state.get("cpu_bucket", None)
        if prev_bucket != None and prev_bucket != bucket:
            # Bucket boundary crossed: emit minute-wide totals, reset.
            user_ms   = state.get("cpu_user_ms",   0.0)
            kernel_ms = state.get("cpu_kernel_ms", 0.0)
            idle_ms   = state.get("cpu_idle_ms",   0.0)
            total_ms  = user_ms + kernel_ms + idle_ms
            pct       = ((user_ms + kernel_ms) / total_ms) * 100.0 if total_ms > 0 else 0.0
            m = Metric("system.cpu.util")
            m.time = prev_bucket * BUCKET_NS
            m.fields["pct"] = pct
            tag_identity(m)
            m.tags["data.user"]    = str(int(user_ms))
            m.tags["data.kernel"]  = str(int(kernel_ms))
            m.tags["data.idle"]    = str(int(idle_ms))
            m.tags["data.nice"]    = str(int(state.get("cpu_nice_ms",    0.0)))
            m.tags["data.system"]  = str(int(state.get("cpu_sys_ms",     0.0)))
            m.tags["data.iowait"]  = str(int(state.get("cpu_iowait_ms",  0.0)))
            m.tags["data.irq"]     = str(int(state.get("cpu_irq_ms",     0.0)))
            m.tags["data.softirq"] = str(int(state.get("cpu_softirq_ms", 0.0)))
            m.tags["data.steal"]   = str(int(state.get("cpu_steal_ms",   0.0)))
            out.append(m)
            state["cpu_user_ms"]    = 0.0
            state["cpu_kernel_ms"]  = 0.0
            state["cpu_idle_ms"]    = 0.0
            state["cpu_nice_ms"]    = 0.0
            state["cpu_sys_ms"]     = 0.0
            state["cpu_iowait_ms"]  = 0.0
            state["cpu_irq_ms"]     = 0.0
            state["cpu_softirq_ms"] = 0.0
            state["cpu_steal_ms"]   = 0.0
        state["cpu_bucket"] = bucket
        # Accumulate this 10s sample's ms contribution into the current bucket.
        state["cpu_user_ms"]    = state.get("cpu_user_ms",    0.0) + (u_usr + u_nic) * CPU_MS_PER_PCT
        state["cpu_kernel_ms"]  = state.get("cpu_kernel_ms",  0.0) + (u_sys + u_irq + u_sir) * CPU_MS_PER_PCT
        state["cpu_idle_ms"]    = state.get("cpu_idle_ms",    0.0) + (u_idl + u_iow) * CPU_MS_PER_PCT
        state["cpu_nice_ms"]    = state.get("cpu_nice_ms",    0.0) + u_nic * CPU_MS_PER_PCT
        state["cpu_sys_ms"]     = state.get("cpu_sys_ms",     0.0) + u_sys * CPU_MS_PER_PCT
        state["cpu_iowait_ms"]  = state.get("cpu_iowait_ms",  0.0) + u_iow * CPU_MS_PER_PCT
        state["cpu_irq_ms"]     = state.get("cpu_irq_ms",     0.0) + u_irq * CPU_MS_PER_PCT
        state["cpu_softirq_ms"] = state.get("cpu_softirq_ms", 0.0) + u_sir * CPU_MS_PER_PCT
        state["cpu_steal_ms"]   = state.get("cpu_steal_ms",   0.0) + u_stl * CPU_MS_PER_PCT
        return out

    # system.nfs.ops.count / system.iscsi.ops.count / system.disk.ops.count —
    # one event per op direction per 60s bucket, matching Java's LocalIoCollector
    # which emitted separate op=read / op=write events each with data.op,
    # data.count, data.avgLatency, data.throughput and data.latency.
    #
    # NFS "name" is "<version>/<op>" (e.g. v3/read); iSCSI's is bare
    # "read"/"write" (bpf/estat/iscsi.c:33-34); estat_backend-io's is "read "
    # or "write ". Per-axis rows (cached/uncached, sync/async) accumulate into
    # the direction's bucket before flush.
    #
    # Latency is an ops-weighted mean. bcchelper integer-divides the op count by
    # the sample interval, so a 10s sample holding 1-9 operations floors to
    # iops = 0; weighting by a bare zero would drop those samples and report
    # avgLatency = 0 beside a populated histogram, so the weight floors to 1.
    if name == "estat_nfs" or name == "estat_iscsi" or name == "estat_backend-io":
        if "iops(/s)" not in metric.fields:
            return out
        prefix = "nfs" if name == "estat_nfs" else ("isc" if name == "estat_iscsi" else "dsk")
        op     = io_direction(metric)
        out.extend(track(prefix, op, bucket))
        iops       = float(metric.fields["iops(/s)"]) * 10.0
        latency    = float(metric.fields.get("avg latency(us)", 0))
        throughput = float(metric.fields.get("throughput(k/s)", 0)) * 10.0
        w          = iops if iops > 0 else 1.0
        acc(prefix + "_cnt_",  op, bucket, iops)
        acc(prefix + "_tp_",   op, bucket, throughput)
        acc(prefix + "_lsum_", op, bucket, latency * w)
        acc(prefix + "_lw_",   op, bucket, w)
        return out

    # Accumulate latency histograms from the expanded hist_estat_* rows. The
    # order=3 storage_io processor turns each microseconds string into one
    # metric per histogram bucket (le tag); we sum those counts across the 10s
    # samples making up the 60s bucket, per op direction.
    if name == "hist_estat_nfs" or name == "hist_estat_iscsi" or name == "hist_estat_backend-io":
        prefix = "nfs" if name == "hist_estat_nfs" else ("isc" if name == "hist_estat_iscsi" else "dsk")
        op     = io_direction(metric)
        le     = metric.tags.get("le", "")
        cnt    = int(metric.fields.get("count", 0))
        if le and cnt > 0:
            out.extend(track(prefix, op, bucket))
            k = bkey(prefix + "_hist_", op, bucket)
            hist = state.get(k, {})
            hist[le] = hist.get(le, 0) + cnt
            state[k] = hist
        return out

    if name == "net":
        iface = metric.tags.get("interface", "")
        if not iface:
            return out
        out.extend(track("net", iface, bucket))
        d_in  = cumulative_delta("netb_r_"  + iface, int(metric.fields.get("bytes_recv",   0)))
        d_out = cumulative_delta("netb_s_"  + iface, int(metric.fields.get("bytes_sent",   0)))
        d_ip  = cumulative_delta("netb_rp_" + iface, int(metric.fields.get("packets_recv", 0)))
        d_op  = cumulative_delta("netb_sp_" + iface, int(metric.fields.get("packets_sent", 0)))
        acc("net_in_",  iface, bucket, float(d_in))
        acc("net_out_", iface, bucket, float(d_out))
        acc("net_ip_",  iface, bucket, float(d_ip))
        acc("net_op_",  iface, bucket, float(d_op))
        return out

    # connstat-stats.sh already aggregates by (laddr, raddr, service) the way
    # LocalTCPStatsCollector does (line 7), so Telegraf receives one tcp_stats
    # metric per key — not one per connection. See emit_tcp for how the
    # cumulative and gauge fields are folded into the bucket.
    if name == "tcp_stats":
        key = (metric.tags.get("laddr",   "") + "|" +
               metric.tags.get("raddr",   "") + "|" +
               metric.tags.get("service", ""))
        out.extend(track("tcp", key, bucket))
        conns = float(metric.fields.get("connections", 1))
        if conns <= 0:
            conns = 1.0
        d_in  = cumulative_delta("tcpb_in_"  + key, int(metric.fields.get("inbytes",     0)))
        d_out = cumulative_delta("tcpb_out_" + key, int(metric.fields.get("outbytes",    0)))
        d_rs  = cumulative_delta("tcpb_rs_"  + key, int(metric.fields.get("retranssegs", 0)))
        acc("tcp_in_",  key, bucket, float(d_in))
        acc("tcp_out_", key, bucket, float(d_out))
        acc("tcp_rs_",  key, bucket, float(d_rs))
        # Each sample contributes its own per-connection mean, floored as Java's
        # long division floors each one-second datapoint. connstat-stats.sh has
        # already averaged the four windows across the key's connections; suna
        # and unsent arrive summed, so they are divided here.
        suna = int(float(metric.fields.get("suna",   0)) / conns)
        unst = int(float(metric.fields.get("unsent", 0)) / conns)
        acc("tcp_su_",  key, bucket, float(suna))
        acc("tcp_un_",  key, bucket, float(unst))
        acc("tcp_sw_",  key, bucket, float(metric.fields.get("swnd",   0)))
        acc("tcp_cw_",  key, bucket, float(metric.fields.get("cwnd",   0)))
        acc("tcp_rw_",  key, bucket, float(metric.fields.get("rwnd",   0)))
        acc("tcp_rt_",  key, bucket, float(metric.fields.get("rtt",    0)))
        return out

    return out

def io_direction(metric):
    # estat and hist_estat rows must land on the same key, so both go through
    # this. Only read and write are traced (bpf/estat/nfs.c:59-60,
    # bpf/estat/iscsi.c:33-34); anything else counts as a write, as before.
    d = metric.tags.get("name", "").strip().split("/")[-1]
    return "read" if d == "read" else "write"
'''
