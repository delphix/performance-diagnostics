# Starlark processor — maps Telegraf measurements to Java InsightLogger metric
# names (system.*) with semantics matching Java's pushInsightMetric.
# Attaches rich data.* breakdown fields alongside _value (Telegraf-native names).
#
# Note: round() triggers a Telegraf 1.40.2 starlark resolver bug ("undefined:
# state"). We emit numeric values via plain str() instead.
#
# ${DELPHIX_SYSTEM_UUID} / ${DELPHIX_SYSTEM_VERSION} are substituted at TOML
# parse time from env vars exported by delphix-telegraf-service.
#
# Included by delphix-telegraf-service when FLUENTD_ENABLED flag exists.
[[processors.starlark]]
  namepass = ["cpu", "estat_backend-io", "hist_estat_backend-io", "net", "estat_nfs", "hist_estat_nfs", "estat_iscsi", "hist_estat_iscsi", "tcp_stats"]
  # Run after the base-config storage_io processors (order 1-3): the name=total
  # row filter must execute first, otherwise read + write + total rows all land
  # in our accumulators and NFS/iSCSI ops counts come out doubled.
  order = 4
  source = '''
UUID            = "${DELPHIX_SYSTEM_UUID}"
VERSION         = "${DELPHIX_SYSTEM_VERSION}"
NCPU            = int("${DELPHIX_NCPU}")
# cpu input samples at telegraf.base's 10s interval. CPU_SAMPLE_MS × NCPU / 100
# converts a usage_X percentage (0-100) into whole-system CPU milliseconds
# consumed in state X over that 10s sample (Java LocalCpuCollector's unit).
CPU_SAMPLE_MS   = 10000
CPU_MS_PER_PCT  = CPU_SAMPLE_MS * NCPU / 100.0
BUCKET_NS       = 60 * 1000 * 1000 * 1000

def hist_json(hist):
    # Encode a {bucket_us: count} dict as a JSON object string.
    # Sorted keys give deterministic output matching Java's histogram shape.
    if not hist:
        return ""
    items = []
    for bkt in sorted(hist.keys()):
        items.append('"' + bkt + '":' + str(hist[bkt]))
    return "{" + ",".join(items) + "}"

def tag_identity(m):
    m.tags["systemUniqueId"] = UUID
    m.tags["systemVersion"]  = VERSION
    return m

def cumulative_delta(key, current):
    # Delta since the previous call for this key, or 0 on the first call
    # (no previous baseline). Guards against counter wrap / device reset.
    prev = state.get(key, None)
    state[key] = current
    if prev == None:
        return 0
    d = current - prev
    if d < 0:
        return 0
    return d

def flush_counter(prefix, measurement, field, bucket):
    # If we have crossed a 60s bucket boundary, emit the previous bucket's
    # accumulated sum and reset the accumulator for the new bucket. Returns a
    # list (possibly empty) of metrics to emit.
    bk = prefix + "_bucket"
    ak = prefix + "_acc"
    prev_bucket = state.get(bk, None)
    out = []
    if prev_bucket != None and prev_bucket != bucket:
        acc = state.get(ak, 0.0)
        m = Metric(measurement)
        m.time = prev_bucket * BUCKET_NS
        m.fields[field] = acc
        out.append(tag_identity(m))
        state[ak] = 0.0
    state[bk] = bucket
    return out

def flush_gauge(prefix, measurement, field, bucket):
    # Gauge version: emit the previous bucket's last-seen value when the
    # bucket boundary is crossed. "last" is updated after this call.
    bk = prefix + "_bucket"
    lk = prefix + "_last"
    prev_bucket = state.get(bk, None)
    out = []
    if prev_bucket != None and prev_bucket != bucket and lk in state:
        m = Metric(measurement)
        m.time = prev_bucket * BUCKET_NS
        m.fields[field] = state[lk]
        out.append(tag_identity(m))
    state[bk] = bucket
    return out

def apply(metric):
    name   = metric.name
    ts     = metric.time
    bucket = ts // BUCKET_NS

    # system.cpu.util.pct — matches Java LocalCpuCollector semantics:
    #   user   = (usage_user + usage_nice)   * CPU_MS_PER_PCT per 10s sample
    #   kernel = (usage_system + usage_irq + usage_softirq) * CPU_MS_PER_PCT
    #   idle   = (usage_idle + usage_iowait) * CPU_MS_PER_PCT  (iowait as idle)
    # Each sample's ms contributions accumulate across the 60s bucket; at flush
    # we derive pct from the minute-wide totals — Java accumulated jiffies for
    # the full minute, so sampling the last 10s misrepresents bursty workloads.
    # data.user/kernel/idle emit Java's three-bucket grouping in ms (matching
    # LocalCpuCollector's units: pct/100 × interval_ms × ncpu).
    # steal/guest excluded from numerator and denominator (Java behavior).
    # data.nice/system/iowait/irq/softirq/steal are raw-state extras in ms.
    if name == "cpu":
        if metric.tags.get("cpu") != "cpu-total":
            return [metric]
        if "usage_idle" not in metric.fields:
            return [metric]
        u_usr = float(metric.fields.get("usage_user",    0))
        u_nic = float(metric.fields.get("usage_nice",    0))
        u_sys = float(metric.fields.get("usage_system",  0))
        u_irq = float(metric.fields.get("usage_irq",     0))
        u_sir = float(metric.fields.get("usage_softirq", 0))
        u_idl = float(metric.fields.get("usage_idle",    0))
        u_iow = float(metric.fields.get("usage_iowait",  0))
        u_stl = float(metric.fields.get("usage_steal",   0))
        out = [metric]
        prev_bucket = state.get("cpu_bucket", None)
        if prev_bucket != None and prev_bucket != bucket:
            # Bucket boundary crossed: emit minute-wide totals, reset.
            user_ms   = state.get("cpu_user_ms",   0.0)
            kernel_ms = state.get("cpu_kernel_ms", 0.0)
            idle_ms   = state.get("cpu_idle_ms",   0.0)
            total_ms  = user_ms + kernel_ms + idle_ms
            pct       = ((user_ms + kernel_ms) / total_ms) * 100.0 if total_ms > 0 else 0.0
            m = Metric("system.cpu.util")
            m.time = prev_bucket * BUCKET_NS
            m.fields["pct"] = pct
            out.append(tag_identity(m))
            out[1].tags["data.user"]    = str(int(user_ms))
            out[1].tags["data.kernel"]  = str(int(kernel_ms))
            out[1].tags["data.idle"]    = str(int(idle_ms))
            out[1].tags["data.nice"]    = str(int(state.get("cpu_nice_ms",    0.0)))
            out[1].tags["data.system"]  = str(int(state.get("cpu_sys_ms",     0.0)))
            out[1].tags["data.iowait"]  = str(int(state.get("cpu_iowait_ms",  0.0)))
            out[1].tags["data.irq"]     = str(int(state.get("cpu_irq_ms",     0.0)))
            out[1].tags["data.softirq"] = str(int(state.get("cpu_softirq_ms", 0.0)))
            out[1].tags["data.steal"]   = str(int(state.get("cpu_steal_ms",   0.0)))
            state["cpu_user_ms"]    = 0.0
            state["cpu_kernel_ms"]  = 0.0
            state["cpu_idle_ms"]    = 0.0
            state["cpu_nice_ms"]    = 0.0
            state["cpu_sys_ms"]     = 0.0
            state["cpu_iowait_ms"]  = 0.0
            state["cpu_irq_ms"]     = 0.0
            state["cpu_softirq_ms"] = 0.0
            state["cpu_steal_ms"]   = 0.0
        state["cpu_bucket"] = bucket
        # Accumulate this 10s sample's ms contribution into the current bucket.
        state["cpu_user_ms"]    = state.get("cpu_user_ms",    0.0) + (u_usr + u_nic) * CPU_MS_PER_PCT
        state["cpu_kernel_ms"]  = state.get("cpu_kernel_ms",  0.0) + (u_sys + u_irq + u_sir) * CPU_MS_PER_PCT
        state["cpu_idle_ms"]    = state.get("cpu_idle_ms",    0.0) + (u_idl + u_iow) * CPU_MS_PER_PCT
        state["cpu_nice_ms"]    = state.get("cpu_nice_ms",    0.0) + u_nic * CPU_MS_PER_PCT
        state["cpu_sys_ms"]     = state.get("cpu_sys_ms",     0.0) + u_sys * CPU_MS_PER_PCT
        state["cpu_iowait_ms"]  = state.get("cpu_iowait_ms",  0.0) + u_iow * CPU_MS_PER_PCT
        state["cpu_irq_ms"]     = state.get("cpu_irq_ms",     0.0) + u_irq * CPU_MS_PER_PCT
        state["cpu_softirq_ms"] = state.get("cpu_softirq_ms", 0.0) + u_sir * CPU_MS_PER_PCT
        state["cpu_steal_ms"]   = state.get("cpu_steal_ms",   0.0) + u_stl * CPU_MS_PER_PCT
        return out

    # system.nfs.ops.count — two events per 60s bucket (one per op direction),
    # matching Java's LocalIoCollector which emitted separate op=read / op=write
    # events each with data.op, data.count, data.avgLatency, data.throughput.
    # NFS "name" tag is "<version>/<op>" (e.g. v3/read, v4/write); split-and-last
    # extracts the direction. Per-axis rows (cached/uncached, sync/async) are
    # accumulated into the direction bucket before flush.
    # Latency: ops-weighted mean with floor-to-1 fallback for bcchelper-floored
    # rows (see R3-2 fix). Throughput: per-sample KB summed over bucket.
    if name == "estat_nfs":
        if "iops(/s)" not in metric.fields:
            return [metric]
        iops       = float(metric.fields["iops(/s)"]) * 10.0
        latency    = float(metric.fields.get("avg latency(us)", 0))
        throughput = float(metric.fields.get("throughput(k/s)", 0)) * 10.0
        direction  = metric.tags.get("name", "").split("/")[-1]
        prev_bucket = state.get("nfs_bk", None)
        out = [metric]
        if prev_bucket != None and prev_bucket != bucket:
            r_cnt  = state.get("nfs_d_r",    0.0)
            r_lt_w = state.get("nfs_rl_w",   0.0)
            r_avg  = int(state.get("nfs_rl_sum", 0.0) / r_lt_w) if r_lt_w > 0 else 0
            w_cnt  = state.get("nfs_d_w",    0.0)
            w_lt_w = state.get("nfs_wl_w",   0.0)
            w_avg  = int(state.get("nfs_wl_sum", 0.0) / w_lt_w) if w_lt_w > 0 else 0
            r_hist = state.get("nfs_hist_read",  {})
            w_hist = state.get("nfs_hist_write", {})
            # Only emit if there were actual ops (count>0) or the histogram has
            # data (ops happened but bcchelper floored iops to 0). Matches Java
            # which never emits zero-count events with no histogram.
            if int(r_cnt) > 0:
                mr = Metric("system.nfs.ops")
                mr.time = prev_bucket * BUCKET_NS
                mr.fields["count"] = int(r_cnt)
                out.append(tag_identity(mr))
                out[-1].tags["data.op"]         = "read"
                out[-1].tags["data.count"]      = str(int(r_cnt))
                out[-1].tags["data.avgLatency"] = str(r_avg)
                out[-1].tags["data.throughput"] = str(int(state.get("nfs_rt", 0.0)))
                r_lt_json = hist_json(r_hist)
                if r_lt_json:
                    out[-1].tags["data.latency"] = r_lt_json
            if int(w_cnt) > 0:
                mw = Metric("system.nfs.ops")
                mw.time = prev_bucket * BUCKET_NS
                mw.fields["count"] = int(w_cnt)
                out.append(tag_identity(mw))
                out[-1].tags["data.op"]         = "write"
                out[-1].tags["data.count"]      = str(int(w_cnt))
                out[-1].tags["data.avgLatency"] = str(w_avg)
                out[-1].tags["data.throughput"] = str(int(state.get("nfs_wt", 0.0)))
                w_lt_json = hist_json(w_hist)
                if w_lt_json:
                    out[-1].tags["data.latency"] = w_lt_json
            state["nfs_d_r"]       = 0.0
            state["nfs_d_w"]       = 0.0
            state["nfs_rt"]        = 0.0
            state["nfs_wt"]        = 0.0
            state["nfs_rl_sum"]    = 0.0
            state["nfs_wl_sum"]    = 0.0
            state["nfs_rl_w"]      = 0.0
            state["nfs_wl_w"]      = 0.0
            state["nfs_hist_read"] = {}
            state["nfs_hist_write"]= {}
        state["nfs_bk"] = bucket
        if direction == "read":
            w = iops if iops > 0 else 1.0
            state["nfs_d_r"]    = state.get("nfs_d_r",    0.0) + iops
            state["nfs_rt"]     = state.get("nfs_rt",     0.0) + throughput
            state["nfs_rl_sum"] = state.get("nfs_rl_sum", 0.0) + latency * w
            state["nfs_rl_w"]   = state.get("nfs_rl_w",   0.0) + w
        else:
            w = iops if iops > 0 else 1.0
            state["nfs_d_w"]    = state.get("nfs_d_w",    0.0) + iops
            state["nfs_wt"]     = state.get("nfs_wt",     0.0) + throughput
            state["nfs_wl_sum"] = state.get("nfs_wl_sum", 0.0) + latency * w
            state["nfs_wl_w"]   = state.get("nfs_wl_w",   0.0) + w
        return out

    # system.iscsi.ops.count — same two-event-per-bucket pattern as NFS.
    # iSCSI "name" tag is bare "read"/"write" per bpf/estat/iscsi.c.
    if name == "estat_iscsi":
        if "iops(/s)" not in metric.fields:
            return [metric]
        iops       = float(metric.fields["iops(/s)"]) * 10.0
        latency    = float(metric.fields.get("avg latency(us)", 0))
        throughput = float(metric.fields.get("throughput(k/s)", 0)) * 10.0
        direction  = metric.tags.get("name", "").split("/")[-1]
        prev_bucket = state.get("isc_bk", None)
        out = [metric]
        if prev_bucket != None and prev_bucket != bucket:
            r_cnt  = state.get("isc_d_r",    0.0)
            r_lt_w = state.get("isc_rl_w",   0.0)
            r_avg  = int(state.get("isc_rl_sum", 0.0) / r_lt_w) if r_lt_w > 0 else 0
            w_cnt  = state.get("isc_d_w",    0.0)
            w_lt_w = state.get("isc_wl_w",   0.0)
            w_avg  = int(state.get("isc_wl_sum", 0.0) / w_lt_w) if w_lt_w > 0 else 0
            r_hist = state.get("isc_hist_read",  {})
            w_hist = state.get("isc_hist_write", {})
            if int(r_cnt) > 0:
                mr = Metric("system.iscsi.ops")
                mr.time = prev_bucket * BUCKET_NS
                mr.fields["count"] = int(r_cnt)
                out.append(tag_identity(mr))
                out[-1].tags["data.op"]         = "read"
                out[-1].tags["data.count"]      = str(int(r_cnt))
                out[-1].tags["data.avgLatency"] = str(r_avg)
                out[-1].tags["data.throughput"] = str(int(state.get("isc_rt", 0.0)))
                r_lt_json = hist_json(r_hist)
                if r_lt_json:
                    out[-1].tags["data.latency"] = r_lt_json
            if int(w_cnt) > 0:
                mw = Metric("system.iscsi.ops")
                mw.time = prev_bucket * BUCKET_NS
                mw.fields["count"] = int(w_cnt)
                out.append(tag_identity(mw))
                out[-1].tags["data.op"]         = "write"
                out[-1].tags["data.count"]      = str(int(w_cnt))
                out[-1].tags["data.avgLatency"] = str(w_avg)
                out[-1].tags["data.throughput"] = str(int(state.get("isc_wt", 0.0)))
                w_lt_json = hist_json(w_hist)
                if w_lt_json:
                    out[-1].tags["data.latency"] = w_lt_json
            state["isc_d_r"]       = 0.0
            state["isc_d_w"]       = 0.0
            state["isc_rt"]        = 0.0
            state["isc_wt"]        = 0.0
            state["isc_rl_sum"]    = 0.0
            state["isc_wl_sum"]    = 0.0
            state["isc_rl_w"]      = 0.0
            state["isc_wl_w"]      = 0.0
            state["isc_hist_read"] = {}
            state["isc_hist_write"]= {}
        state["isc_bk"] = bucket
        if direction == "read":
            w = iops if iops > 0 else 1.0
            state["isc_d_r"]    = state.get("isc_d_r",    0.0) + iops
            state["isc_rt"]     = state.get("isc_rt",     0.0) + throughput
            state["isc_rl_sum"] = state.get("isc_rl_sum", 0.0) + latency * w
            state["isc_rl_w"]   = state.get("isc_rl_w",   0.0) + w
        else:
            w = iops if iops > 0 else 1.0
            state["isc_d_w"]    = state.get("isc_d_w",    0.0) + iops
            state["isc_wt"]     = state.get("isc_wt",     0.0) + throughput
            state["isc_wl_sum"] = state.get("isc_wl_sum", 0.0) + latency * w
            state["isc_wl_w"]   = state.get("isc_wl_w",   0.0) + w
        return out

    # system.net.total.bytes — one event per network interface, matching
    # LocalNetworkInterfaceCollector.java which reads /proc/net/dev and emits
    # one datapoint per interface (line 191: "networkInterface is always included,
    # as the data is useless without that context"). _value = inBytes + outBytes,
    # type = SUMMARY. Per-interface bucket state avoids cross-interface aggregation.
    if name == "net":
        iface    = metric.tags.get("interface", "")
        recv     = int(metric.fields.get("bytes_recv",   0))
        sent     = int(metric.fields.get("bytes_sent",   0))
        recv_pkt = int(metric.fields.get("packets_recv", 0))
        sent_pkt = int(metric.fields.get("packets_sent", 0))
        d_in  = cumulative_delta("net_r_"  + iface, recv)
        d_out = cumulative_delta("net_s_"  + iface, sent)
        d_ip  = cumulative_delta("net_rp_" + iface, recv_pkt)
        d_op  = cumulative_delta("net_sp_" + iface, sent_pkt)
        bk          = "net_bk_"  + iface
        prev_bucket = state.get(bk, None)
        out = [metric]
        if prev_bucket != None and prev_bucket != bucket:
            in_b  = state.get("net_in_" + iface, 0.0)
            out_b = state.get("net_out_" + iface, 0.0)
            m = Metric("system.net.total")
            m.time = prev_bucket * BUCKET_NS
            m.fields["bytes"] = int(in_b + out_b)
            out.append(tag_identity(m))
            out[1].tags["data.networkInterface"] = iface
            out[1].tags["data.inBytes"]          = str(int(in_b))
            out[1].tags["data.outBytes"]         = str(int(out_b))
            out[1].tags["data.inPackets"]        = str(int(state.get("net_ip_" + iface, 0.0)))
            out[1].tags["data.outPackets"]       = str(int(state.get("net_op_" + iface, 0.0)))
            state["net_in_"  + iface] = 0.0
            state["net_out_" + iface] = 0.0
            state["net_ip_"  + iface] = 0.0
            state["net_op_"  + iface] = 0.0
        state[bk]                 = bucket
        state["net_in_"  + iface] = state.get("net_in_"  + iface, 0.0) + float(d_in)
        state["net_out_" + iface] = state.get("net_out_" + iface, 0.0) + float(d_out)
        state["net_ip_"  + iface] = state.get("net_ip_"  + iface, 0.0) + float(d_ip)
        state["net_op_"  + iface] = state.get("net_op_"  + iface, 0.0) + float(d_op)
        return out

    # system.disk.ops.count — sourced from estat_backend-io (BPF tracing), matching
    # Java's LocalIoCollector which used TracingDataCollector("io"). estat_backend-io
    # uses the "name" tag for op direction ("read ", "write ") and is engine-wide.
    # Latency histogram is accumulated from hist_estat_backend-io per-bucket rows
    # (see handler below) into state["dsk_hist_{op}"] before flush.
    if name == "estat_backend-io":
        if "iops(/s)" not in metric.fields:
            return [metric]
        op         = metric.tags.get("name", "").strip()
        iops       = float(metric.fields["iops(/s)"]) * 10.0
        latency    = float(metric.fields.get("avg latency(us)", 0))
        throughput = float(metric.fields.get("throughput(k/s)", 0)) * 10.0
        key        = op
        bk         = "dsk_bk_" + key
        prev_bucket = state.get(bk, None)
        out = [metric]
        if prev_bucket != None and prev_bucket != bucket:
            cnt    = state.get("dsk_cnt_"  + key, 0.0)
            dsk_lt = state.get("dsk_lt_w_" + key, 0.0)
            avg_lt = int(dsk_lt / cnt) if cnt > 0 else 0
            d_hist = state.get("dsk_hist_" + key, {})
            if int(cnt) > 0:
              m = Metric("system.disk.ops")
              m.time = prev_bucket * BUCKET_NS
              m.fields["count"] = int(cnt)
              out.append(tag_identity(m))
              out[-1].tags["data.op"]          = op
              out[-1].tags["data.count"]       = str(int(cnt))
              out[-1].tags["data.avgLatency"]  = str(avg_lt)
              out[-1].tags["data.throughput"]  = str(int(state.get("dsk_tp_" + key, 0.0)))
              lt_json = hist_json(d_hist)
              if lt_json:
                  out[-1].tags["data.latency"] = lt_json
            state["dsk_cnt_"  + key] = 0.0
            state["dsk_tp_"   + key] = 0.0
            state["dsk_lt_w_" + key] = 0.0
            state["dsk_hist_" + key] = {}
        state[bk]                 = bucket
        state["dsk_cnt_"  + key]  = state.get("dsk_cnt_"  + key, 0.0) + iops
        state["dsk_tp_"   + key]  = state.get("dsk_tp_"   + key, 0.0) + throughput
        state["dsk_lt_w_" + key]  = state.get("dsk_lt_w_" + key, 0.0) + latency * iops
        return out

    # Accumulate disk latency histogram from expanded hist_estat_backend-io rows.
    # order=3 expands each microseconds string into one metric per bucket (le tag).
    # We sum counts across all 10s samples in the 60s bucket per op direction.
    if name == "hist_estat_backend-io":
        op  = metric.tags.get("name", "").strip()
        bkt = metric.tags.get("le", "")
        cnt = int(metric.fields.get("count", 0))
        if op and bkt and cnt > 0:
            hist = state.get("dsk_hist_" + op, {})
            hist[bkt] = hist.get(bkt, 0) + cnt
            state["dsk_hist_" + op] = hist
        return [metric]

    # Accumulate NFS latency histogram from hist_estat_nfs per-bucket rows.
    if name == "hist_estat_nfs":
        direction = metric.tags.get("name", "").split("/")[-1]
        bkt       = metric.tags.get("le", "")
        cnt       = int(metric.fields.get("count", 0))
        if direction and bkt and cnt > 0:
            key  = "nfs_hist_" + direction
            hist = state.get(key, {})
            hist[bkt] = hist.get(bkt, 0) + cnt
            state[key] = hist
        return [metric]

    # Accumulate iSCSI latency histogram from hist_estat_iscsi per-bucket rows.
    if name == "hist_estat_iscsi":
        direction = metric.tags.get("name", "").strip()
        bkt       = metric.tags.get("le", "")
        cnt       = int(metric.fields.get("count", 0))
        if direction and bkt and cnt > 0:
            key  = "isc_hist_" + direction
            hist = state.get(key, {})
            hist[bkt] = hist.get(bkt, 0) + cnt
            state[key] = hist
        return [metric]

    # system.tcp.total.bytes — one event per (laddr, raddr, service) per bucket,
    # matching LocalTCPStatsCollector which aggregates by service and emits one
    # datapoint per (laddr, raddr, service) group (BY_SERVICE compare mode).
    # connstat-stats.sh already does this same aggregation (line 7: "mirrors the
    # aggregation done by LocalTCPStatsCollector"), so Telegraf receives one
    # tcp_stats metric per key — not one per connection.
    #
    # Cumulative fields (inbytes, outbytes, retranssegs, suna, unsent) are summed
    # across the 60s bucket via cumulative_delta. Instantaneous fields (swnd, cwnd,
    # rwnd, rtt) are already averaged across connections by connstat; we store the
    # last value seen in the bucket (matches Java's representative-connection approach).
    if name == "tcp_stats":
        laddr   = metric.tags.get("laddr",   "")
        raddr   = metric.tags.get("raddr",   "")
        service = metric.tags.get("service", "")
        key     = laddr + "|" + raddr + "|" + service
        inb     = int(metric.fields.get("inbytes",     0))
        outb    = int(metric.fields.get("outbytes",    0))
        rseg    = int(metric.fields.get("retranssegs", 0))
        suna    = int(metric.fields.get("suna",        0))
        unsent  = int(metric.fields.get("unsent",      0))
        swnd    = int(metric.fields.get("swnd",        0))
        cwnd    = int(metric.fields.get("cwnd",        0))
        rwnd    = int(metric.fields.get("rwnd",        0))
        rtt     = int(metric.fields.get("rtt",         0))
        d_in  = cumulative_delta("tcp_in_"  + key, inb)
        d_out = cumulative_delta("tcp_out_" + key, outb)
        d_rs  = cumulative_delta("tcp_rs_"  + key, rseg)
        d_su  = cumulative_delta("tcp_su_"  + key, suna)
        d_un  = cumulative_delta("tcp_un_"  + key, unsent)
        bk          = "tcp_bk_" + key
        prev_bucket = state.get(bk, None)
        out = [metric]
        if prev_bucket != None and prev_bucket != bucket:
            in_b  = state.get("tcp_in2_"  + key, 0.0)
            out_b = state.get("tcp_out2_" + key, 0.0)
            m = Metric("system.tcp.total")
            m.time = prev_bucket * BUCKET_NS
            m.fields["bytes"] = int(in_b + out_b)
            out.append(tag_identity(m))
            out[1].tags["data.localAddress"]        = laddr
            out[1].tags["data.remoteAddress"]       = raddr
            out[1].tags["data.service"]             = service
            out[1].tags["data.inBytes"]             = str(int(in_b))
            out[1].tags["data.outBytes"]            = str(int(out_b))
            out[1].tags["data.retransmittedSegs"]   = str(int(state.get("tcp_rs2_" + key, 0.0)))
            out[1].tags["data.unacknowledgedBytes"] = str(int(state.get("tcp_su2_" + key, 0.0)))
            out[1].tags["data.unsentBytes"]         = str(int(state.get("tcp_un2_" + key, 0.0)))
            out[1].tags["data.sendWindowSize"]      = str(state.get("tcp_sw_"  + key, 0))
            out[1].tags["data.congestionWindowSize"]= str(state.get("tcp_cw_"  + key, 0))
            out[1].tags["data.receiveWindowSize"]   = str(state.get("tcp_rw_"  + key, 0))
            out[1].tags["data.roundTripTime"]       = str(state.get("tcp_rt_"  + key, 0))
            state["tcp_in2_"  + key] = 0.0
            state["tcp_out2_" + key] = 0.0
            state["tcp_rs2_"  + key] = 0.0
            state["tcp_su2_"  + key] = 0.0
            state["tcp_un2_"  + key] = 0.0
        state[bk]                 = bucket
        state["tcp_in2_"  + key]  = state.get("tcp_in2_"  + key, 0.0) + float(d_in)
        state["tcp_out2_" + key]  = state.get("tcp_out2_" + key, 0.0) + float(d_out)
        state["tcp_rs2_"  + key]  = state.get("tcp_rs2_"  + key, 0.0) + float(d_rs)
        state["tcp_su2_"  + key]  = state.get("tcp_su2_"  + key, 0.0) + float(d_su)
        state["tcp_un2_"  + key]  = state.get("tcp_un2_"  + key, 0.0) + float(d_un)
        state["tcp_sw_"   + key]  = swnd
        state["tcp_cw_"   + key]  = cwnd
        state["tcp_rw_"   + key]  = rwnd
        state["tcp_rt_"   + key]  = rtt
        return out

    return [metric]
'''
