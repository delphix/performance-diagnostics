#
# Script that enables and disables fluentd 3rd-party metric forwarding for Telegraf.
#

FLUENTD_FLAG=/etc/telegraf/FLUENTD_ENABLED

function die() {
	echo -e "$(date +%T:%N:%z): $(basename $0): $*" >&2
	exit 1
}

[[ $EUID -ne 0 ]] && die "must be run as root"

function usage() {
	echo "$(basename $0): $*" >&2
	echo "Usage: $(basename $0) [enable|disable|status]"
	exit 2
}

function enable_fluentd() {
	date
	if [[ -f $FLUENTD_FLAG ]]; then
		echo "fluentd forwarding already enabled — nothing to do"
		return 0
	fi
	echo "Enabling fluentd 3rd-party metric forwarding"
	touch $FLUENTD_FLAG || die "Failed to create $FLUENTD_FLAG"
	systemctl restart delphix-telegraf || die "Failed to restart delphix-telegraf"
}

function disable_fluentd() {
	date
	if [[ ! -f $FLUENTD_FLAG ]]; then
		echo "fluentd forwarding already disabled — nothing to do"
		return 0
	fi
	echo "Disabling fluentd 3rd-party metric forwarding"
	rm -f $FLUENTD_FLAG
	systemctl restart delphix-telegraf || die "Failed to restart delphix-telegraf"
}

function status_fluentd() {
	if [[ -f $FLUENTD_FLAG ]]; then
		echo "fluentd forwarding: enabled"
	else
		echo "fluentd forwarding: disabled"
	fi
	echo -n "delphix-telegraf: "
	systemctl is-active delphix-telegraf
}

if [[ $# -ne 1 ]]; then
	usage
fi

case "$1" in
enable)  enable_fluentd ;;
disable) disable_fluentd ;;
status)  status_fluentd ;;
*) usage ;;
esac
